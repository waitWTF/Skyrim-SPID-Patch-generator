<Window x:Class="WearableDistributor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wearable Distributor" Icon="assets/WearableDistributor.ico" Height="760" Width="1120" MinHeight="600" MinWidth="850"
        Background="#F3F5F2">
  <DockPanel Margin="20">
    <Border DockPanel.Dock="Top" Background="#23362D" CornerRadius="12" Padding="18" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Wearable Distributor" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Choose wearable mods, then configure who gets what." Foreground="#D8E4DC" Margin="0,5,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="Scan now" Click="Scan_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="10" Padding="12" Margin="0,14,0,0">
      <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Exclude selected plugin(s)" Click="IgnorePlugin_Click"/>
          <Button Content="Restore selected exclusion(s)" Click="RestorePlugin_Click"/>
          <Button Content="Generate Patch" Background="#6E9F83" Foreground="White" FontWeight="SemiBold" Click="Generate_Click"/>
        </StackPanel><StackPanel><TextBlock x:Name="StatusText" Text="Choose a Skyrim Data folder in Preferences." TextWrapping="Wrap"/>
          <ProgressBar x:Name="ActionProgress" Height="8" Margin="0,7,20,0" Minimum="0" Maximum="100" Visibility="Collapsed"/></StackPanel></DockPanel>
    </Border>
    <TabControl x:Name="MainTabs">
      <TabItem Header="Plugins / outfits">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Wearable plugins" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Plugins are grouped alphabetically by plugin name. Select the mods you want to patch; each gets its own distribution setup page." Foreground="#58665E" Margin="0,4,0,8"/>
            <DockPanel><TextBox x:Name="SearchBox" Padding="8" Width="320" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged" ToolTip="Search plugin names"/>
              <CheckBox x:Name="ShowIgnoredBox" Content="Show remembered exclusions" Margin="12,0" VerticalAlignment="Center" Checked="RefreshPluginList" Unchecked="RefreshPluginList"/></DockPanel>
            <WrapPanel Margin="0,8,0,0">
              <CheckBox x:Name="ShowFilteredBox" Content="Show candidates hidden by smart filter" ToolTip="Reveal wearable plugins hidden by the smart scan. Select a row, then choose Include selected filtered candidates to remember it." VerticalAlignment="Center" Margin="4" Checked="RefreshPluginList" Unchecked="RefreshPluginList"/>
              <Button Content="Include selected filtered candidates" ToolTip="Remember selected candidates as allowed, even when the smart filter would normally hold them back." Click="IncludeFiltered_Click"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Select all" Click="SelectAll_Click"/>
              <Button Content="Select none" Click="SelectNone_Click"/>
              <Button Content="Invert selection" Click="InvertSelection_Click"/>
              <Button Content="Enable selected" Click="EnableSelected_Click"/>
              <Button Content="Disable selected" Click="DisableSelected_Click"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="PluginsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Patch" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
              <DataGridTextColumn Header="Plugin / mod" Binding="{Binding Plugin}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Wearable records" Binding="{Binding PieceCount}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Filter note" Binding="{Binding FilterReason}" Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="Installed path" Binding="{Binding SourcePath}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Preferences">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Preferences" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <TextBlock Text="Plugin scan root (game Data or Vortex staging folder)" FontWeight="SemiBold"/>
          <TextBlock Text="Choose the game's Data folder if your mods are deployed there. For Vortex, choose its staging folder containing the installed mod folders. The scan reads plugins in that folder tree, including staged mods that may be disabled." Foreground="#58665E" TextWrapping="Wrap" Margin="0,4,0,6"/>
          <DockPanel Margin="0,5,0,14"><TextBox x:Name="DataPathBox" Padding="8" MinWidth="480"/>
            <Button Content="Browse…" Click="BrowseData_Click"/></DockPanel>
          <TextBlock Text="Default distribution framework" FontWeight="SemiBold"/>
          <ComboBox x:Name="DefaultFrameworkBox" Width="180" HorizontalAlignment="Left" Margin="0,5,0,14">
            <ComboBoxItem Content="SPID"/><ComboBoxItem Content="SkyPatcher"/></ComboBox>
          <TextBlock Text="Default chance" FontWeight="SemiBold"/>
          <ComboBox x:Name="DefaultChanceBox" Width="180" HorizontalAlignment="Left" Margin="0,5,0,14">
            <ComboBoxItem Content="100% — full replacement"/><ComboBoxItem Content="80%"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="25%"/><ComboBoxItem Content="10%"/><ComboBoxItem Content="5%"/></ComboBox>
          <CheckBox x:Name="IncludeAccessoriesBox" Content="Include accessory-only plugins (rings, earrings, amulets, horns)" Margin="0,0,0,14"/>
          <TextBlock Text="Additional plugin-name exclusions (one term per line)" FontWeight="SemiBold"/>
          <TextBox x:Name="ExclusionsBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,14"/>
          <Button Content="Save preferences" HorizontalAlignment="Left" Click="SavePreferences_Click"/>
          <TextBlock Text="Remembered plugin exclusions are saved automatically when you remove a plugin from the scan list." Foreground="#58665E" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
