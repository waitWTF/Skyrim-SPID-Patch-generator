<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.4.12</Version>
    <AssemblyVersion>0.4.12.0</AssemblyVersion>
    <FileVersion>0.4.12.0</FileVersion>
    <!-- MO2 2.5.2 / USVFS cannot inject into CET-enabled .NET apphosts.
         App-only compatibility opt-out; no Windows security settings are changed. -->
    <CETCompat>false</CETCompat>
    <AssemblyName>SkyrimSPIDPatchGenerator</AssemblyName>
    <Product>Skyrim SPID Patch Generator</Product>
    <Title>Skyrim SPID Patch Generator</Title>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\WearableDistributor.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Translations\*.json" />
    <Content Include="Translations\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="assets\WearableDistributor.ico" />
  </ItemGroup>
  <Import Project="..\tools\ReleaseLayout.targets" />
</Project>
